gt.blockmachines.fluxecho.insight_echo.name=Insight Echo
gt.blockmachines.fluxecho.crucible_echo.name=Crucible Echo
fluxecho.recipe.insight_echo=Insight Echo
fluxecho.recipe.crucible_echo=Crucible Echo
fluxecho.insight_echo.tip=§3Scans what you have scanned again, for research points§r\nSpecial slot: an item its owner has scanned with a thaumometer; it stays there\nEach cycle takes a paper and gives the owner that item's research points again (Thaumcraft's own cap still applies)\nThe owner must be online\n%s s per cycle, %s EU/t
fluxecho.crucible_echo.tip=§3Crucible recipes without throwing anything into a crucible§r\nPut the catalyst in; the essentia the recipe needs is synthesized: %s EU per unit, one vis crystal shard pays for %s units (keep shards in the input)\nOnly recipes the owner has researched and whose aspects the team has learned\nWhen one catalyst fits several recipes, a programmed circuit picks which
gt.blockmachines.fluxecho.infusion_echo.name=Infusion Echo
fluxecho.recipe.infusion_echo=Infusion Echo
fluxecho.infusion_echo.tip=§3Repeats an infusion you made by hand: no pedestals, no instability§r\nSpecial slot: a finished item you infused (or made at the arcane workbench) once; it stays there\nInputs: everything its recipe takes (infusion: the centre and every component; arcane: every ingredient)\nAn infusion's essentia is synthesized from EU: %s EU per unit, a vis crystal shard pays %s units (shards in the inputs)\nAn arcane recipe's vis costs 1 primal unit per vis\nOnly recipes the owner researched and whose aspects the team learned; no warp

# blood magic
gt.blockmachines.fluxecho.blood_echo.name=Blood Echo
fluxecho.recipe.blood_echo=Blood Echo
fluxecho.blood_echo.tip=§3Makes LP from EU and a little meat: no more self-sacrifice§r\nSpecial slot: a bound blood orb; it stays there and its level sets the pace (weak %s LP/t ... transcendent %s LP/t)\n%s EU per LP; one raw meat or rotten flesh in the input per %s LP\nNo circuit or circuit 1: into the main tank of a blood altar within %s blocks (%s up or down)\nCircuit 2: into the orb owner's soul network, up to the orb's capacity\nWaits while the altar or network is full
fluxecho.blood_echo.waila_altar=Altar mode: %s LP/t, %s LP waiting
fluxecho.blood_echo.waila_network=Soul network mode: %s LP/t, %s LP waiting

